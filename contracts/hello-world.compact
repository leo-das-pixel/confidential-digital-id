pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger credentialName: Opaque<"string">;
export ledger verificationCount: Counter;

constructor(name: Opaque<"string">) {
    credentialName = disclose(name);
}

export circuit verifyCredential(credentialSecret: Opaque<"string">): [] {
    // The credentialSecret is passed as a private witness.
    // By NOT calling disclose(credentialSecret), it remains completely private.
    // We just increment the public verificationCount to prove this transaction was valid.
    
    // Increment the public verification count by 1
    verificationCount.increment(1);
}
