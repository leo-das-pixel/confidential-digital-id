{
  "name": "@midnight-ntwrk/cipherid-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/hello-world.compact ./src/managed/hello-world",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/hello-world.compact ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run compact && npm run typecheck && npm run build"
  }
}
